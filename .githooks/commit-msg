#!/usr/bin/env bash
# Validates that commit messages follow Conventional Commits format.
# See CONTRIBUTING.md for the full specification.

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Allow merge commits, revert commits, and fixup/squash commits
if echo "$commit_msg" | grep -qE "^(Merge|Revert|fixup!|squash!)"; then
  exit 0
fi

# Allowed types (extend here when adding new ones)
pattern="^(feat|fix|perf|refactor|eval|prompt|docs|test|chore|ci|style|build)(\(.+\))?(!)?: .{1,100}"

if ! echo "$commit_msg" | grep -qP "$pattern"; then
  echo ""
  echo "❌  Commit message does not follow Conventional Commits format."
  echo ""
  echo "    Expected: <type>(<scope>): <description>"
  echo "    Example:  feat(classification): add heuristic fast-path for DATABASE queries"
  echo ""
  echo "    Allowed types: feat, fix, perf, refactor, eval, prompt, docs, test, chore, ci, style, build"
  echo "    Breaking change: append ! before the colon  (e.g. feat!: ...)"
  echo ""
  echo "    See CONTRIBUTING.md for the full specification."
  echo ""
  exit 1
fi

exit 0
