# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_key_here

# MLflow Experiment Tracking
# SQLite backend (recommended local store):
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=txt2sql-agent
# Remote server example:
# MLFLOW_TRACKING_URI=http://localhost:5000

# Database Configuration
# Main runtime database: local DuckDB file.
# Use an absolute path so API, CLI, tests, and frontend launcher resolve the same DB.
DATABASE_PATH=duckdb:////absolute/path/to/sihrd5.duckdb?access_mode=read_only

# Optional alias for advanced SQLAlchemy URL configuration.
# If DATABASE_URL is set, it takes precedence over DATABASE_PATH.
# DATABASE_URL=duckdb:////absolute/path/to/sihrd5.duckdb?access_mode=read_only
