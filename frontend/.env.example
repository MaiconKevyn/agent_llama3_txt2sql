# DataVisSUS Web Interface Configuration
# Copy this file to .env and adjust the values as needed

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Agent API Configuration
API_BASE_URL=http://localhost:8000/api/v1

# CORS Configuration (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000

# Vercel example:
# API_BASE_URL=https://your-api-project.vercel.app/api/v1
# ALLOWED_ORIGINS=https://your-frontend-project.vercel.app

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
QUERY_RATE_LIMIT_WINDOW_MS=60000
QUERY_RATE_LIMIT_MAX_REQUESTS=10

# Security Configuration
ENABLE_HELMET=true
ENABLE_COMPRESSION=true

# Development Configuration
ENABLE_DEBUG_ROUTES=true
