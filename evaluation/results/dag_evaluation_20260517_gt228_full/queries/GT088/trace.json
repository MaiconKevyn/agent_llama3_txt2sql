  "ground_truth_sql": "SELECT mu.\"NO_MUNICIPIO\" AS municipio, ROUND(SUM(CASE WHEN i.\"VAL_UTI\" > 0 THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS pct_uti FROM internacoes i JOIN municipios mu ON i.\"MUNIC_RES\" = mu.\"CO_MUNICIPIO_6D\" GROUP BY mu.\"NO_MUNICIPIO\" HAVING COUNT(*) > 5000 ORDER BY pct_uti DESC LIMIT 5;",
  "generated_sql": "WITH municipio_internacoes AS ( SELECT mu.\"NO_MUNICIPIO\" AS municipio, COUNT(*) AS total_internacoes, SUM(CASE WHEN i.\"VAL_UTI\" > 0 THEN 1 ELSE 0 END) AS total_uti FROM internacoes i JOIN municipios mu ON i.\"MUNIC_RES\" = mu.\"CO_MUNICIPIO_6D\" GROUP BY mu.\"NO_MUNICIPIO\" HAVING COUNT(*) > 5000 ), percentuais AS ( SELECT municipio, total_internacoes, total_uti, (total_uti * 100.0 / total_internacoes) AS taxa_uti FROM municipio_internacoes ) SELECT municipio, taxa_uti FROM percentuais ORDER BY taxa_uti DESC LIMIT 5;",
