  "ground_truth_sql": "SELECT m.\"SG_UF\" AS uf, ROUND(AVG(s.\"VL_MEDICOS_1000\"), 2) AS media_medicos_1000 FROM socioeconomico s JOIN municipios m ON s.\"CO_MUNICIPIO_6D\" = m.\"CO_MUNICIPIO_6D\" WHERE s.\"NU_ANO\" = 2021 AND s.\"VL_MEDICOS_1000\" IS NOT NULL AND regexp_full_match(m.\"SG_UF\", '^[A-Z]{2}$') GROUP BY m.\"SG_UF\" ORDER BY media_medicos_1000 DESC;",
