  "question_pt": "Quais são os 10 hospitais com maior taxa de mortalidade obstétrica (com mais de 500 internações obstétricas)?",
  "question_started_at": "2026-05-17T06:39:11.368219",
  "question_completed_at": "2026-05-17T06:39:26.350421",
  "ground_truth_sql": "SELECT h.\"CNES\", COUNT(*) AS total_obstetricos, SUM(CASE WHEN i.\"MORTE\" = true THEN 1 ELSE 0 END) AS total_mortes, ROUND(SUM(CASE WHEN i.\"MORTE\" = true THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS pct_mortalidade FROM internacoes i JOIN hospital h ON i.\"CNES\" = h.\"CNES\" WHERE i.\"ESPEC\" = 2 GROUP BY h.\"CNES\" HAVING COUNT(*) > 500 ORDER BY pct_mortalidade DESC LIMIT 10;",
