      "answerability": "answerable",
      "response": "A taxa de internações por 100 mil habitantes em 2019 por UF é a seguinte:\n\n1. PR: 7.723,48\n2. RR: 7.551,66\n3. SC: 7.137,64\n4. RO: 6.836,78\n5. RS: 6.762,76\n6. MA: 6.546,45\n7. PI: 6.509,11\n8. MS: 6.480,89\n9. ES: 6.219,43\n10. MG: 6.078,87\n11. DF: 6.050,34\n12. PE: 5.980,78\n13. CE: 5.772,11\n14. BA: 5.733,55\n15. MT: 5.700,33\n16. PA: 5.678,38\n17. GO: 5.536,95\n18. SP: 5.471,06\n19. TO: 5.411,20\n20. AL: 5.252,69\n21. RN: 5.143,27\n22. AC: 4.970,55\n23. AM: 4.802,32\n24. PB: 4.789,87\n25. AP: 4.617,66\n26. RJ: 4.222,91\n27. SE: 4.134,82",
      "sql": "WITH internacoes_por_uf AS (SELECT mu.\"SG_UF\" AS uf, COUNT(*) AS total_internacoes FROM internacoes i JOIN municipios mu ON i.\"MUNIC_RES\" = mu.\"CO_MUNICIPIO_6D\" WHERE EXTRACT(YEAR FROM i.\"DT_INTER\") = 2019 GROUP BY mu.\"SG_UF\"), populacao_por_uf AS (SELECT m.\"SG_UF\" AS uf, SUM(s.\"QT_POPULACAO\") AS populacao FROM socioeconomico s JOIN municipios m ON s.\"CO_MUNICIPIO_6D\" = m.\"CO_MUNICIPIO_6D\" WHERE s.\"NU_ANO\" = 2019 GROUP BY m.\"SG_UF\") SELECT i.uf, i.total_internacoes, p.populacao, ROUND(i.total_internacoes * 100000.0 / NULLIF(p.populacao, 0), 2) AS taxa_por_100k FROM internacoes_por_uf i JOIN populacao_por_uf p ON i.uf = p.uf ORDER BY taxa_por_100k DESC;",
