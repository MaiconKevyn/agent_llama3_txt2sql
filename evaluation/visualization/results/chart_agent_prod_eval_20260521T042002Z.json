      "agent": {
        "success": true,
        "error": null,
        "response": "Os estados com menor taxa de mortalidade hospitalar são:\n\n1. PA: 2,33\n2. MA: 2,37\n3. PI: 2,78\n4. RR: 2,85\n5. RO: 2,85\n6. AP: 2,88\n7. AC: 3,01\n8. TO: 3,04\n9. AM: 3,06\n10. GO: 3,34",
        "answer": null,
        "sql_query": "WITH taxa_mortalidade AS ( SELECT mu.\"SG_UF\" AS estado, COUNT(*) AS total_internacoes, SUM(CASE WHEN i.\"MORTE\" = true THEN 1 ELSE 0 END) AS total_mortes FROM internacoes i JOIN municipios mu ON i.\"MUNIC_RES\" = mu.\"CO_MUNICIPIO_6D\" GROUP BY mu.\"SG_UF\" ) SELECT estado, ROUND(total_mortes * 100.0 / total_internacoes, 2) AS taxa_mortalidade FROM taxa_mortalidade WHERE total_internacoes > 0 ORDER BY taxa_mortalidade ASC LIMIT 10;",
