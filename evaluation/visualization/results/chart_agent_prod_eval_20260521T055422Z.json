        "response": "As mortes por faixa etária são as seguintes:\n\n1. 60 anos ou mais: 5.207.105 mortes\n2. 30 a 59 anos: 2.015.622 mortes\n3. Menor de 1 ano: 362.745 mortes\n4. 15 a 29 anos: 284.114 mortes\n5. 5 a 14 anos: 38.202 mortes",
        "answer": null,
        "sql_query": "SELECT CASE WHEN i.\"IDADE\" < 1 THEN 'Menor de 1 ano' WHEN i.\"IDADE\" BETWEEN 1 AND 4 THEN '1 a 4 anos' WHEN i.\"IDADE\" BETWEEN 5 AND 14 THEN '5 a 14 anos' WHEN i.\"IDADE\" BETWEEN 15 AND 29 THEN '15 a 29 anos' WHEN i.\"IDADE\" BETWEEN 30 AND 59 THEN '30 a 59 anos' WHEN i.\"IDADE\" >= 60 THEN '60 anos ou mais' ELSE 'Nao informado' END AS faixa_etaria, COUNT(*) AS total_mortes FROM internacoes i  WHERE i.\"IDADE\" IS NOT NULL AND i.\"MORTE\" = true GROUP BY CASE WHEN i.\"IDADE\" < 1 THEN 'Menor de 1 ano' WHEN i.\"IDADE\" BETWEEN 1 AND 4 THEN '1 a 4 anos' WHEN i.\"IDADE\" BETWEEN 5 AND 14 THEN '5 a 14 anos' WHEN i.\"IDADE\" BETWEEN 15 AND 29 THEN '15 a 29 anos' WHEN i.\"IDADE\" BETWEEN 30 AND 59 THEN '30 a 59 anos' WHEN i.\"IDADE\" >= 60 THEN '60 anos ou mais' ELSE 'Nao informado' END ORDER BY total_mortes DESC;",
