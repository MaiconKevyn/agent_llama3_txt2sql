      "agent": {
        "success": true,
        "error": null,
        "elapsed_seconds": 13.014677,
        "sql_query": "WITH max_ano AS ( SELECT MAX(EXTRACT(YEAR FROM \"DT_INTER\")) AS ano_max FROM internacoes WHERE \"DT_INTER\" IS NOT NULL) SELECT EXTRACT(YEAR FROM i.\"DT_INTER\") AS ano, CASE WHEN i.\"SEXO\" = 1 THEN 'homens' WHEN i.\"SEXO\" = 3 THEN 'mulheres' END AS sexo, COUNT(*) AS total_mortes FROM internacoes i CROSS JOIN max_ano m WHERE i.\"MORTE\" = true AND i.\"SEXO\" IN (1, 3) AND i.\"DT_INTER\" IS NOT NULL AND EXTRACT(YEAR FROM i.\"DT_INTER\") BETWEEN m.ano_max - 4 AND m.ano_max GROUP BY EXTRACT(YEAR FROM i.\"DT_INTER\"), i.\"SEXO\" ORDER BY ano, sexo;",
        "row_count": 10,
        "chart_type": "line",
        "x": "ano",
        "y": "total_mortes",
        "series": "sexo",
        "chart_type_correct": true,
