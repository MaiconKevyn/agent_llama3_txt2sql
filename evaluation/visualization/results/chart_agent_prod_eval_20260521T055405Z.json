        "error": null,
        "response": "A taxa de mortalidade por raça/cor é a seguinte:\n\n1. Preta: 5,25\n2. Branca: 4,94\n3. Amarela: 4,34\n4. Parda: 3,63\n5. Indígena: 2,06",
        "answer": null,
        "sql_query": "SELECT r.\"DESCRICAO\" AS raca_cor, ROUND(SUM(CASE WHEN i.\"MORTE\" = true THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS taxa_mortalidade FROM internacoes i JOIN raca_cor r ON i.\"RACA_COR\" = r.\"RACA_COR\" WHERE i.\"RACA_COR\" IN (1, 2, 3, 4, 5) GROUP BY r.\"DESCRICAO\" ORDER BY taxa_mortalidade DESC;",
