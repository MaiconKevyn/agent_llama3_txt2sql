        "sql_query": "WITH municipio_taxa AS ( SELECT mu.\"NO_MUNICIPIO\" AS municipio, COUNT(*) AS total_internacoes, SUM(CASE WHEN i.\"MORTE\" = true THEN 1 ELSE 0 END) AS total_mortes, ROUND(SUM(CASE WHEN i.\"MORTE\" = true THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS taxa_mortalidade FROM internacoes i JOIN municipios mu ON i.\"MUNIC_RES\" = mu.\"CO_MUNICIPIO_6D\" GROUP BY mu.\"NO_MUNICIPIO\" ), ranked_municipios AS ( SELECT municipio, total_internacoes, total_mortes, taxa_mortalidade, ROW_NUMBER() OVER (ORDER BY taxa_mortalidade DESC) AS rank FROM municipio_taxa ) SELECT municipio, total_internacoes, total_mortes, taxa_mortalidade FROM ranked_municipios WHERE rank <= 10;",
