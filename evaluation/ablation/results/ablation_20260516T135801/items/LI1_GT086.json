    "question": "Quais são os 3 hospitais com maior custo médio de UTI por estado (MA e RS)?",
    "gold_sql": "SELECT estado, \"CNES\", ROUND(custo_medio_uti, 2) AS custo_medio_uti\nFROM (\n    SELECT mu.\"SG_UF\" AS estado,\n           h.\"CNES\",\n           AVG(i.\"VAL_UTI\") AS custo_medio_uti,\n           ROW_NUMBER() OVER (PARTITION BY mu.\"SG_UF\" ORDER BY AVG(i.\"VAL_UTI\") DESC) AS rn\n    FROM internacoes i\n    JOIN hospital h ON i.\"CNES\" = h.\"CNES\"\n    JOIN municipios mu ON h.\"MUNIC_MOV\" = mu.\"CO_MUNICIPIO_6D\"\n    WHERE i.\"VAL_UTI\" > 0 AND mu.\"SG_UF\" IN ('MA', 'RS')\n    GROUP BY mu.\"SG_UF\", h.\"CNES\"\n    HAVING COUNT(*) > 100\n) sub\nWHERE rn <= 3\nORDER BY estado, rn;",
