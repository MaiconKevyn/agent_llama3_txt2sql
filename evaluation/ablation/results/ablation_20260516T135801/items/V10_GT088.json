    "question": "Quais são os 5 municípios com maior percentual de internações em UTI (com mais de 5000 internações)?",
    "gold_sql": "SELECT mu.\"NO_MUNICIPIO\" AS municipio, ROUND(SUM(CASE WHEN i.\"VAL_UTI\" > 0 THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS pct_uti FROM internacoes i JOIN municipios mu ON i.\"MUNIC_RES\" = mu.\"CO_MUNICIPIO_6D\" GROUP BY mu.\"NO_MUNICIPIO\" HAVING COUNT(*) > 5000 ORDER BY pct_uti DESC LIMIT 5;",
    "generated_sql": "WITH total_internacoes AS ( SELECT \"MUNIC_RES\", COUNT(*) AS total FROM internacoes GROUP BY \"MUNIC_RES\" HAVING COUNT(*) > 5000 ), uti_internacoes AS ( SELECT \"MUNIC_RES\", COUNT(*) AS total_uti FROM internacoes WHERE \"VAL_UTI\" > 0 GROUP BY \"MUNIC_RES\" ) SELECT mu.\"NO_MUNICIPIO\", ROUND(COALESCE(ui.total_uti, 0) * 100.0 / ti.total, 2) AS taxa_uti FROM total_internacoes ti JOIN municipios mu ON ti.\"MUNIC_RES\" = mu.\"CO_MUNICIPIO_6D\" LEFT JOIN uti_internacoes ui ON ti.\"MUNIC_RES\" = ui.\"MUNIC_RES\" ORDER BY taxa_uti DESC LIMIT 5;",
