    "question": "Quais são os 5 municípios com maior percentual de internações em UTI (com mais de 5000 internações)?",
    "gold_sql": "SELECT mu.\"NO_MUNICIPIO\" AS municipio, ROUND(SUM(CASE WHEN i.\"VAL_UTI\" > 0 THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS pct_uti FROM internacoes i JOIN municipios mu ON i.\"MUNIC_RES\" = mu.\"CO_MUNICIPIO_6D\" GROUP BY mu.\"NO_MUNICIPIO\" HAVING COUNT(*) > 5000 ORDER BY pct_uti DESC LIMIT 5;",
    "generated_sql": "WITH municipio_internacoes AS ( SELECT mu.\"NO_MUNICIPIO\", COUNT(*) AS total_internacoes, SUM(CASE WHEN i.\"VAL_UTI\" > 0 THEN 1 ELSE 0 END) AS total_uti FROM internacoes i JOIN municipios mu ON i.\"MUNIC_RES\" = mu.\"CO_MUNICIPIO_6D\" GROUP BY mu.\"NO_MUNICIPIO\" HAVING COUNT(*) > 5000 ) SELECT \"NO_MUNICIPIO\", ROUND((total_uti * 100.0 / total_internacoes), 2) AS taxa_uti FROM municipio_internacoes ORDER BY taxa_uti DESC LIMIT 5;",
