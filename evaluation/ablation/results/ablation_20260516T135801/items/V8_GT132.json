    "question": "Quais os 3 hospitais com maior valor médio de serviço hospitalar (VAL_SH) por estado (MA e RS), considerando hospitais com mais de 500 internações?",
    "gold_sql": "SELECT estado, \"CNES\", avg_val_sh\nFROM (\n    SELECT mu.\"SG_UF\" AS estado,\n           i.\"CNES\",\n           ROUND(AVG(i.\"VAL_SH\"), 2) AS avg_val_sh,\n           ROW_NUMBER() OVER (PARTITION BY mu.\"SG_UF\" ORDER BY AVG(i.\"VAL_SH\") DESC) AS rn\n    FROM internacoes i\n    JOIN hospital h ON i.\"CNES\" = h.\"CNES\"\n    JOIN municipios mu ON h.\"MUNIC_MOV\" = mu.\"CO_MUNICIPIO_6D\"\n    WHERE mu.\"SG_UF\" IN ('MA', 'RS') AND i.\"VAL_SH\" IS NOT NULL\n    GROUP BY mu.\"SG_UF\", i.\"CNES\"\n    HAVING COUNT(*) > 500\n) sub\nWHERE rn <= 3\nORDER BY estado, avg_val_sh DESC;",
    "generated_sql": "SELECT mu.\"SG_UF\" AS estado_hospital, h.\"CNES\", AVG(i.\"VAL_SH\") AS media_val_sh FROM internacoes i JOIN hospital h ON i.\"CNES\" = h.\"CNES\" JOIN municipios mu ON h.\"MUNIC_MOV\" = mu.\"CO_MUNICIPIO_6D\" GROUP BY mu.\"SG_UF\", h.\"CNES\" HAVING COUNT(*) > 500 AND mu.\"SG_UF\" IN ('MA', 'RS') ORDER BY estado_hospital, media_val_sh DESC;",
