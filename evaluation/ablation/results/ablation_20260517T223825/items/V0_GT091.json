    "question": "Quais são os 5 hospitais mais eficientes em custo por dia de internação (com mais de 1000 internações)?",
    "gold_sql": "SELECT h.\"CNES\", ROUND(SUM(i.\"VAL_TOT\") / NULLIF(SUM(i.\"DIAS_PERM\"), 0), 2) AS custo_por_dia FROM internacoes i JOIN hospital h ON i.\"CNES\" = h.\"CNES\" WHERE i.\"VAL_TOT\" IS NOT NULL GROUP BY h.\"CNES\" HAVING COUNT(*) > 1000 ORDER BY custo_por_dia ASC LIMIT 5;",
