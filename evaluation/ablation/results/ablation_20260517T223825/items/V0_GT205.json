    "difficulty": "hard",
    "question": "Quais municipios do RS tem taxa de uso de UTI acima da media estadual, considerando apenas municipios com mais de 1000 internacoes?",
    "gold_sql": "WITH rs AS (SELECT m.\"NO_MUNICIPIO\" AS municipio, COUNT(*) AS total_internacoes, SUM(CASE WHEN i.\"MARCA_UTI\" <> 0 THEN 1 ELSE 0 END) AS internacoes_uti FROM internacoes i LEFT JOIN municipios m ON i.\"MUNIC_RES\" = m.\"CO_MUNICIPIO_6D\" WHERE m.\"SG_UF\" = 'RS' GROUP BY m.\"NO_MUNICIPIO\"), media AS (SELECT SUM(internacoes_uti) * 100.0 / NULLIF(SUM(total_internacoes), 0) AS taxa_media_rs FROM rs) SELECT rs.municipio, rs.total_internacoes, rs.internacoes_uti, ROUND(rs.internacoes_uti * 100.0 / NULLIF(rs.total_internacoes, 0), 2) AS taxa_uti FROM rs, media WHERE rs.total_internacoes > 1000 AND rs.internacoes_uti * 100.0 / NULLIF(rs.total_internacoes, 0) > media.taxa_media_rs ORDER BY taxa_uti DESC LIMIT 10;",
    "generated_sql": "WITH taxa_uti AS ( SELECT mu.\"NO_MUNICIPIO\" AS municipio, COUNT(*) AS total_internacoes, SUM(CASE WHEN i.\"VAL_UTI\" > 0 THEN 1 ELSE 0 END) * 100.0 / COUNT(*) AS taxa_uti FROM internacoes i JOIN municipios mu ON i.\"MUNIC_RES\" = mu.\"CO_MUNICIPIO_6D\" WHERE mu.\"SG_UF\" = 'RS' GROUP BY mu.\"NO_MUNICIPIO\" HAVING COUNT(*) > 1000 ), media_estado AS ( SELECT AVG(t.\"taxa_uti\") AS taxa_media FROM taxa_uti t ) SELECT t.municipio, t.taxa_uti FROM taxa_uti t, media_estado m WHERE t.taxa_uti > m.taxa_media ORDER BY t.taxa_uti DESC;",
