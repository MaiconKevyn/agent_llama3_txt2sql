    "difficulty": "hard",
    "question": "Quais pares de estado de residencia e estado do hospital tiveram maior volume de internacoes interestaduais?",
    "gold_sql": "WITH base AS (SELECT mr.\"SG_UF\" AS uf_residencia, mh.\"SG_UF\" AS uf_hospital FROM internacoes i LEFT JOIN municipios mr ON i.\"MUNIC_RES\" = mr.\"CO_MUNICIPIO_6D\" JOIN hospital h ON i.\"CNES\" = h.\"CNES\" JOIN municipios mh ON h.\"MUNIC_MOV\" = mh.\"CO_MUNICIPIO_6D\" WHERE regexp_full_match(mr.\"SG_UF\", '^[A-Z]{2}$') AND regexp_full_match(mh.\"SG_UF\", '^[A-Z]{2}$')) SELECT uf_residencia, uf_hospital, COUNT(*) AS total_internacoes FROM base WHERE uf_residencia <> uf_hospital GROUP BY uf_residencia, uf_hospital ORDER BY total_internacoes DESC LIMIT 10;",
    "generated_sql": "SELECT mu_hospital.\"SG_UF\" AS estado_hospital, i.\"CNES\" AS hospital, mu_residencia.\"SG_UF\" AS estado_residencia, COUNT(*) AS total_internacoes FROM internacoes i JOIN hospital h ON i.\"CNES\" = h.\"CNES\" JOIN municipios mu_hospital ON h.\"MUNIC_MOV\" = mu_hospital.\"CO_MUNICIPIO_6D\" JOIN municipios mu_residencia ON i.\"MUNIC_RES\" = mu_residencia.\"CO_MUNICIPIO_6D\" WHERE mu_hospital.\"SG_UF\" <> mu_residencia.\"SG_UF\" GROUP BY mu_hospital.\"SG_UF\", i.\"CNES\", mu_residencia.\"SG_UF\" ORDER BY total_internacoes DESC LIMIT 1;",
