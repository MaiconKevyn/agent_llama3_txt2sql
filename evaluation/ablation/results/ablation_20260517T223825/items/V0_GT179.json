    "question": "Qual a taxa de mortalidade por raca/cor identificada?",
    "gold_sql": "SELECT r.\"DESCRICAO\" AS raca_cor, COUNT(*) AS total_internacoes, SUM(CASE WHEN i.\"MORTE\" = true THEN 1 ELSE 0 END) AS total_mortes, ROUND(SUM(CASE WHEN i.\"MORTE\" = true THEN 1 ELSE 0 END) * 100.0 / NULLIF(COUNT(*), 0), 2) AS taxa_mortalidade FROM internacoes i JOIN raca_cor r ON i.\"RACA_COR\" = r.\"RACA_COR\" WHERE i.\"RACA_COR\" IN (1, 2, 3, 4, 5) GROUP BY r.\"DESCRICAO\" ORDER BY taxa_mortalidade DESC;",
